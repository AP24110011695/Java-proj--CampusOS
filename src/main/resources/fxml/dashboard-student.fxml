<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campusos.controller.DashboardStudentController">
    <top>
        <VBox spacing="4">
            <Label fx:id="welcomeLabel" text="Welcome back" styleClass="title-large"/>
            <Label text="Your campus life at a glance - bookings, complaints and events"
                   styleClass="section-subtitle"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
        <VBox spacing="16">
            <HBox fx:id="kpiRow" spacing="14"/>
            <HBox spacing="16">
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="My upcoming registered events" styleClass="card-title"/>
                    <TableView fx:id="eventsTable">
                        <columns>
                            <TableColumn fx:id="eventTitle" text="Event" prefWidth="220"/>
                            <TableColumn fx:id="eventVenue" text="Venue" prefWidth="120"/>
                            <TableColumn fx:id="eventStart" text="Starts" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="My recent bookings" styleClass="card-title"/>
                    <TableView fx:id="bookingsTable">
                        <columns>
                            <TableColumn fx:id="bookingResource" text="Resource" prefWidth="150"/>
                            <TableColumn fx:id="bookingDate" text="Date" prefWidth="95"/>
                            <TableColumn fx:id="bookingStatus" text="Status" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
            <HBox spacing="16">
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="My complaints" styleClass="card-title"/>
                    <TableView fx:id="complaintsTable">
                        <columns>
                            <TableColumn fx:id="complaintTitle" text="Complaint" prefWidth="220"/>
                            <TableColumn fx:id="complaintStatus" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="complaintUpdated" text="Last update" prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS" maxWidth="470">
                    <Label text="My recent activity" styleClass="card-title"/>
                    <TableView fx:id="activityTable">
                        <columns>
                            <TableColumn fx:id="activityTime" text="When" prefWidth="140"/>
                            <TableColumn fx:id="activityAction" text="Activity" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
