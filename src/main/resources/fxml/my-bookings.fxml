<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campusos.controller.MyBookingsController">
    <top>
        <VBox spacing="10">
            <Label text="Your booking requests and complete booking history" styleClass="section-subtitle"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="statusFilter" prefWidth="150" onAction="#handleApplyFilters"/>
                <Button text="Refresh" onAction="#handleApplyFilters"/>
                <Button fx:id="newBookingButton" text="＋ New booking request" styleClass="btn-primary"
                        onAction="#handleNewBooking"/>
                <Button fx:id="cancelButton" text="✕ Cancel selected" styleClass="btn-ghost-danger"
                        onAction="#handleCancel"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <TableView fx:id="bookingTable">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colResource" text="Resource" prefWidth="180"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colStart" text="Start" prefWidth="75"/>
                    <TableColumn fx:id="colEnd" text="End" prefWidth="75"/>
                    <TableColumn fx:id="colPurpose" text="Purpose" prefWidth="230"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                    <TableColumn fx:id="colRemarks" text="Admin remarks" prefWidth="170"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <Label fx:id="hintLabel" styleClass="meta-label" wrapText="true"
                   text="New requests start as PENDING and are approved or rejected by an administrator (Booking Approvals). Pending requests can be cancelled any time; approved bookings only before the slot starts."/>
        </VBox>
    </center>
</BorderPane>
