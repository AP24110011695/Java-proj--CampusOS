<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campusos.controller.UserManagementController">
    <top>
        <VBox spacing="10">
            <Label text="Manage students, faculty and administrators" styleClass="section-subtitle"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search name, email or ID..." prefWidth="260"
                           onAction="#handleApplyFilters"/>
                <ComboBox fx:id="roleFilter" prefWidth="140" onAction="#handleApplyFilters"/>
                <ComboBox fx:id="departmentFilter" prefWidth="200" onAction="#handleApplyFilters"/>
                <Button text="Search" styleClass="btn-primary" onAction="#handleApplyFilters"/>
                <Button text="Clear" styleClass="btn-outline" onAction="#handleClearFilters"/>
                <HBox spacing="8">
                    <Button fx:id="addButton" text="＋ Add user" styleClass="btn-primary" onAction="#handleAddUser"/>
                    <Button fx:id="exportButton" text="⇩ Export" styleClass="btn-outline" onAction="#handleExport"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <TableView fx:id="userTable">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colName" text="Full name" prefWidth="170"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="210"/>
                    <TableColumn fx:id="colRole" text="Role" prefWidth="100"/>
                    <TableColumn fx:id="colIdentifier" text="ID number" prefWidth="120"/>
                    <TableColumn fx:id="colDepartment" text="Department" prefWidth="180"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="editButton" text="✎ Edit selected" onAction="#handleEditUser"/>
                <Button fx:id="toggleActiveButton" text="⏻ Deactivate selected" onAction="#handleToggleActive"/>
                <Button fx:id="resetPasswordButton" text="🔑 Reset password" onAction="#handleResetPassword"/>
                <Label fx:id="hintLabel" styleClass="meta-label" text="Select a row to enable actions"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
