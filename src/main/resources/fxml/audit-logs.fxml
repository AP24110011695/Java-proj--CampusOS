<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campusos.controller.AuditLogController">
    <top>
        <VBox spacing="10">
            <Label text="Append-only audit trail of every important system activity" styleClass="section-subtitle"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="actionFilter" promptText="Filter by action e.g. BOOKING" prefWidth="220"
                           onAction="#handleApplyFilters"/>
                <ComboBox fx:id="userFilter" prefWidth="220"/>
                <Button text="Search" styleClass="btn-primary" onAction="#handleApplyFilters"/>
                <Button text="Clear" onAction="#handleClearFilters"/>
                <Button text="⟳ Refresh" onAction="#handleApplyFilters"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <TableView fx:id="auditTable">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colTime" text="Timestamp" prefWidth="150"/>
                    <TableColumn fx:id="colUser" text="User" prefWidth="160"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="190"/>
                    <TableColumn fx:id="colEntity" text="Entity" prefWidth="110"/>
                    <TableColumn fx:id="colEntityId" text="Entity ID" prefWidth="80"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="380"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <Label fx:id="countLabel" styleClass="meta-label"/>
        </VBox>
    </center>
</BorderPane>
