<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campusos.controller.ComplaintsAdminController">
    <top>
        <VBox spacing="10">
            <Label text="All campus complaints - assign to faculty, track and close the lifecycle"
                   styleClass="section-subtitle"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="statusFilter" prefWidth="140" onAction="#handleApplyFilters"/>
                <ComboBox fx:id="categoryFilter" prefWidth="140" onAction="#handleApplyFilters"/>
                <ComboBox fx:id="priorityFilter" prefWidth="130" onAction="#handleApplyFilters"/>
                <ComboBox fx:id="departmentFilter" prefWidth="180" onAction="#handleApplyFilters"/>
                <TextField fx:id="searchField" promptText="Search title or description..." prefWidth="200"
                           onAction="#handleApplyFilters"/>
                <Button text="Search" styleClass="btn-primary" onAction="#handleApplyFilters"/>
                <Button text="⇩ Export CSV" onAction="#handleExport"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <TableView fx:id="complaintTable">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="220"/>
                    <TableColumn fx:id="colSubmitter" text="Submitted by" prefWidth="150"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                    <TableColumn fx:id="colPriority" text="Priority" prefWidth="95"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="105"/>
                    <TableColumn fx:id="colDepartment" text="Department" prefWidth="140"/>
                    <TableColumn fx:id="colAssignedTo" text="Assigned to" prefWidth="140"/>
                    <TableColumn fx:id="colCreated" text="Created" prefWidth="120"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="assignButton" text="👤 Assign to faculty" styleClass="btn-primary"
                        onAction="#handleAssign"/>
                <Button fx:id="detailButton" text="🔍 Open details &amp; history" onAction="#handleOpenDetail"/>
                <Button fx:id="closeButton" text="✔ Close complaint" styleClass="btn-success"
                        onAction="#handleClose"/>
                <Label fx:id="hintLabel" styleClass="meta-label" text="Select a complaint to act on it"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
