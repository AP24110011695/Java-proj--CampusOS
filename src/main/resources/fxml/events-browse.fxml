<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campusos.controller.EventsBrowseController">
    <top>
        <VBox spacing="10">
            <Label text="Browse upcoming campus events and manage your registrations"
                   styleClass="section-subtitle"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search title, venue, description..." prefWidth="280"
                           onAction="#handleApplyFilters"/>
                <Button text="Search" styleClass="btn-primary" onAction="#handleApplyFilters"/>
                <Button text="Refresh" onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Upcoming events">
                <VBox spacing="8">
                    <padding><javafx.geometry.Insets top="10"/></padding>
                    <TableView fx:id="eventTable">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colTitle" text="Event" prefWidth="210"/>
                            <TableColumn fx:id="colVenue" text="Venue" prefWidth="130"/>
                            <TableColumn fx:id="colStart" text="Starts" prefWidth="130"/>
                            <TableColumn fx:id="colDeadline" text="Register before" prefWidth="130"/>
                            <TableColumn fx:id="colSeats" text="Seats" prefWidth="100"/>
                            <TableColumn fx:id="colOrganizer" text="Organizer" prefWidth="140"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="registerButton" text="✓ Register for selected event"
                                styleClass="btn-success" onAction="#handleRegister"/>
                        <Label fx:id="eventHint" styleClass="meta-label"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="My registrations">
                <VBox spacing="8">
                    <padding><javafx.geometry.Insets top="10"/></padding>
                    <TableView fx:id="registrationTable">
                        <columns>
                            <TableColumn fx:id="colRegId" text="Reg ID" prefWidth="60"/>
                            <TableColumn fx:id="colEventTitle" text="Event" prefWidth="230"/>
                            <TableColumn fx:id="colVenue2" text="Venue" prefWidth="130"/>
                            <TableColumn fx:id="colEventStart" text="Starts" prefWidth="130"/>
                            <TableColumn fx:id="colRegStatus" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="colRegisteredAt" text="Registered" prefWidth="140"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="cancelRegButton" text="✕ Cancel selected registration"
                                styleClass="btn-ghost-danger" onAction="#handleCancelRegistration"/>
                        <Label fx:id="regHint" styleClass="meta-label"
                               text="Registered seats can be cancelled any time before the event starts."/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
