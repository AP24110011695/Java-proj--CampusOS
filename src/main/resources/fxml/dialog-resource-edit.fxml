<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campusos.controller.ResourceEditDialogController" prefWidth="450">
    <content>
        <VBox spacing="10">
            <Label fx:id="formError" styleClass="error-banner" wrapText="true" visible="false" managed="false"/>
            <VBox spacing="3"><Label text="Resource name" styleClass="field-label"/>
                <TextField fx:id="nameField"/></VBox>
            <HBox spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Type" styleClass="field-label"/>
                    <ComboBox fx:id="typeCombo" maxWidth="Infinity"/></VBox>
                <VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Status" styleClass="field-label"/>
                    <ComboBox fx:id="statusCombo" maxWidth="Infinity"/></VBox>
            </HBox>
            <HBox spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Location" styleClass="field-label"/>
                    <TextField fx:id="locationField"/></VBox>
                <VBox spacing="3" HBox.hgrow="ALWAYS"><Label text="Capacity (optional)" styleClass="field-label"/>
                    <TextField fx:id="capacityField"/></VBox>
            </HBox>
            <VBox spacing="3"><Label text="Description" styleClass="field-label"/>
                <TextArea fx:id="descriptionField" prefRowCount="3"/></VBox>
        </VBox>
    </content>
</DialogPane>
